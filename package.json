{
  "name": "cmll-trainer",
  "version": "1.10.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@emotion/react": "^11.4.1",
    "@emotion/styled": "^11.3.0",
    "@koale/useworker": "^4.1.2",
    "@material-ui/core": "^4.7.0",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "^4.0.0-alpha.46",
    "@mui/icons-material": "^5.0.1",
    "@mui/material": "^5.0.1",
    "@mui/styles": "^5.0.1",
    "@mui/types": "^7.0.0",
    "@types/chroma-js": "^2.1.3",
    "@types/jest": "^24.0.23",
    "@types/node": "^12.12.11",
    "@types/react": "^17.0.24",
    "@types/react-dom": "^17.0.9",
    "chokidar": "^3.5.2",
    "chroma-js": "^2.1.0",
    "clsx": "^1.0.4",
    "comlink": "^4.3.1",
    "create-react-app": "^4.0.3",
    "fontsource-open-sans": "^3.1.5",
    "fontsource-public-sans": "^3.1.6",
    "fontsource-roboto": "^3.1.5",
    "markdown-to-jsx": "^7.1.3",
    "min2phase": "git+https://github.com/cubing/min2phase.js.git",
    "postcss": "^8.3.8",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-ga": "^3.3.0",
    "react-scripts": "^4.0.3",
    "sr-visualizer": "^1.0.8",
    "three": "^0.125.0",
    "typeface-roboto": "0.0.75",
    "typeface-roboto-mono": "0.0.75",
    "typescript": "^3.9.10",
    "worker-plugin": "^5.0.1"
  },
  "scripts": {
    "start": "react-app-rewired --openssl-legacy-provider start",
    "build": "react-app-rewired --openssl-legacy-provider build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start2": "react-app-rewired start",
    "deploy": "gh-pages -d build",
    "deploy2": "gh-pages -d build;gh-pages -d build -o gitee",
    "publish": "npm run build; npm run deploy",
    "electron:build": "npm run build && electron-builder --win portable",
    "electron:dev": "npm run build && electron . --no-sandbox"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": ".",
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.4.3",
    "electron": "31.7.7",
    "electron-builder": "26.15.3",
    "eslint": "^7.32.0",
    "gh-pages": "^2.2.0",
    "react-app-rewired": "^2.1.8",
    "react-refresh": "^0.8.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.aoi.roux-trainers",
    "productName": "Aoi Roux Trainers",
    "directories": {
      "output": "release"
    },
    "files": [
      "build",
      "electron",
      "node_modules"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": true,
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}